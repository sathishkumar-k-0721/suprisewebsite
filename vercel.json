{
  "functions": {
    "app/**/*.js": {
      "maxDuration": 10
    },
    "app/**/*.ts": {
      "maxDuration": 10
    },
    "pages/**/*.js": {
      "maxDuration": 10
    },
    "pages/**/*.ts": {
      "maxDuration": 10
    }
  },
  "regions": ["fra1"],
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "excludeFiles": [
    "node_modules/@prisma/engines/**",
    "node_modules/@prisma/client/**",
    "node_modules/sharp/**",
    "node_modules/cloudinary/**"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}