{
  "functions": {
    "app/**/*.js": {
      "maxDuration": 30
    },
    "app/**/*.ts": {
      "maxDuration": 30
    },
    "pages/**/*.js": {
      "maxDuration": 30
    },
    "pages/**/*.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["fra1"],
  "buildCommand": "npm run build",
  "installCommand": "npm install && npx prisma generate",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}