{
  "functions": {
    "app/**/*.js": {
      "maxDuration": 10,
      "runtime": "nodejs18.x"
    },
    "app/**/*.ts": {
      "maxDuration": 10,
      "runtime": "nodejs18.x"
    },
    "pages/**/*.js": {
      "maxDuration": 10,
      "runtime": "nodejs18.x"
    },
    "pages/**/*.ts": {
      "maxDuration": 10,
      "runtime": "nodejs18.x"
    }
  },
  "regions": ["fra1"],
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}