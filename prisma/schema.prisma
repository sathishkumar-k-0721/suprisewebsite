// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  websites  Website[]
  payments  Payment[]
  cart      Cart?
}

model Website {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  uniqueUrl   String    @unique
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  description String?
  theme       String?   @default("normal")
  isPublished Boolean   @default(false)
  
  // Date validity fields
  validFrom   DateTime? @default(now())
  validTo     DateTime?
  durationType String   @default("trial") // trial, extended, lifetime
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pages       Page[]
  payment     Payment?
}

model Page {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  websiteId   String   @db.ObjectId
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  templateId  String   // "text-only", "text-with-image", "text-with-video", "photo-gallery"
  order       Int      // Page order: 0, 1, 2, 3...
  content     Json     // User's content: { text, imageName, videoName, galleryCount }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([websiteId, order])
}

model Payment {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteId         String   @unique @db.ObjectId
  website           Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  
  amount            Float
  currency          String   @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            String   @default("pending") // pending, completed, failed
  
  // Duration information
  durationType      String   @default("trial") // trial, extended, lifetime
  validFrom         DateTime @default(now())
  validTo           DateTime?
  
  // Selected pages
  page1Enabled      Boolean  @default(false)
  page2Enabled      Boolean  @default(false)
  page3Enabled      Boolean  @default(false)
  page3HasAudio     Boolean  @default(false)
  page4Enabled      Boolean  @default(false)
  page4HasAudio     Boolean  @default(false)
  page4HasVideo     Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json     // Store items as JSON: { "text-only": { quantity: 2, price: 50, name: "Text Only" } }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  templateId  String   @unique // text-only, text-with-image, text-with-video, photo-gallery
  name        String
  description String
  price       Float
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
